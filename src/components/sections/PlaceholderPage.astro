---
import Container from '../ui/Container.astro';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<section class="py-24 sm:py-32"><Container><p class="mb-6 text-sm uppercase tracking-[0.2em] text-accent">Coming soon</p><h1 class="text-5xl font-medium tracking-tight sm:text-7xl">{title}</h1><p class="mt-7 max-w-xl text-lg leading-relaxed text-ink/70">{description}</p><a href="/" class="mt-10 inline-block underline underline-offset-4">Back to home</a></Container></section>
