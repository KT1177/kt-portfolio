---
interface Props {
  label: string;
  href?: string;
  title?: string;
  fullWidth?: boolean;
}

const { label, href, title, fullWidth = false } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  class:list={['video-cta', { 'video-cta--full': fullWidth }]}
  href={href}
  type={!href ? 'button' : undefined}
  disabled={!href ? true : undefined}
  title={title ?? (!href ? 'Video coming soon' : undefined)}
>
  <svg class="video-cta__icon" viewBox="0 0 40 40" aria-hidden="true" focusable="false">
    <circle cx="20" cy="20" r="19.5" fill="none" stroke="currentColor" />
    <path class="video-cta__play" d="M17 13 L28 20 L17 27 Z" fill="currentColor" />
    <!-- The transparent triangle reveals the actual section background on hover. -->
    <path class="video-cta__fill" fill="currentColor" fill-rule="evenodd" d="M20 0 A20 20 0 1 1 20 40 A20 20 0 1 1 20 0 Z M17 13 L28 20 L17 27 Z" />
  </svg>
  <span class="video-cta__label">{label}</span>
</Tag>

<style>
  .video-cta {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 13px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .video-cta--full { width: 100%; height: 100%; }
  .video-cta__icon { display: block; width: 40px; height: 40px; flex: 0 0 40px; }
  .video-cta__label {
    font-size: .75rem;
    font-weight: 400;
    letter-spacing: .08em;
    line-height: 1.3;
    text-transform: uppercase;
    opacity: .8;
  }
  .video-cta__fill { opacity: 0; }
  .video-cta__fill, .video-cta__play, .video-cta__label { transition: opacity 180ms ease; }
  .video-cta:is(:hover, :focus-visible):not(:disabled) .video-cta__fill { opacity: 1; }
  .video-cta:is(:hover, :focus-visible):not(:disabled) .video-cta__play { opacity: 0; }
  .video-cta:is(:hover, :focus-visible):not(:disabled) .video-cta__label { opacity: 1; }
  .video-cta:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  .video-cta:disabled { opacity: .7; cursor: not-allowed; }
  @media (prefers-reduced-motion: reduce) {
    .video-cta__fill, .video-cta__play, .video-cta__label { transition: none; }
  }
</style>
