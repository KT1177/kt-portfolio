---
import { smartCityUrl } from '../../data/smart-city-media';
---
<section id="smart-city-media" class="chapter">
      <div class="scm-editorial">
        <div class="scm-photographic-hero dark">
          <img src={smartCityUrl("JC-kiosk-city.webp") ?? "/images/media-placeholder.svg"} alt="" loading="lazy" decoding="async"/>
          <div class="chapter-copy scm-introduction">
            <p class="chapter-meta"><span>03</span><strong><span class="meta-year">2013+</span><small>The platform scales</small></strong></p>
            <h2>Smart City Media</h2>
            <h3>One city became many.</h3>
            <p>I went on to cofound Smart City Media, expanding the idea into a city publishing platform deployed across major urban and transit environments.</p>
          </div>
        </div>
        <div class="proof-row scm-proof">
          <div class="stat"><strong>1,000</strong><span>Outdoor screens<small>At peak</small></span></div>
          <div class="scm-edison">
            <img src={smartCityUrl("edison-gold-award.webp") ?? "/images/media-placeholder.svg"} alt="Edison Awards Gold badge" loading="lazy" decoding="async"/>
            <div>
              <p class="eyebrow">Gold Edison Award</p>
              <p>Collective Disruption</p>
              <p>The City of Kansas City, MO</p>
            </div>
          </div>
        </div>
      </div>
    </section>
