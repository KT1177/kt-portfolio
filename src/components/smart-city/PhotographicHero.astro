---
import { getImage } from 'astro:assets';
import { smartCityUrl } from '../../data/smart-city-media';
interface Props { file: 'call-box-city.webp' | 'JC-kiosk-city.webp'; alt: string; }
const { file, alt } = Astro.props;
const src = smartCityUrl(file);
const width = 2560, height = 1429;
// Tall mobile cover frames need more source resolution than viewport width alone.
const widths = file === 'JC-kiosk-city.webp' ? [2240,2560] : [1920,2240,2560];
const sizes = 'max(100vw, 1920px)';
const variants = src ? await Promise.all(widths.map(async target => {
  const transform = { src, width:target, height:Math.ceil(target*height/width), fit:'inside' as const };
  const [avif,webp] = await Promise.all([
    getImage({...transform,format:'avif',quality:80}),
    target===width ? Promise.resolve({src}) : getImage({...transform,format:'webp',quality:90}),
  ]);
  return {width:target,avif:avif.src,webp:webp.src};
})) : [];
---
{src ? <picture style="display:contents">
  <!-- Original masters are preferable to another native-size lossy encode. -->
  <source media="(min-resolution: 1.25dppx), (min-width: 2241px)" type="image/webp" srcset={`${src} 2560w`} sizes={sizes} />
  <source type="image/avif" srcset={variants.map(v=>`${v.avif} ${v.width}w`).join(', ')} sizes={sizes} />
  <img src={src} srcset={variants.map(v=>`${v.webp} ${v.width}w`).join(', ')} sizes={sizes} width={width} height={height} alt={alt} loading="lazy" decoding="async" />
</picture> : <img src="/images/media-placeholder.svg" alt={alt} loading="lazy" decoding="async" />}
