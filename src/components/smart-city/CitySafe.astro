---
import PhotographicHero from './PhotographicHero.astro';
import SupportingPhoto from './SupportingPhoto.astro';
import CapabilityPills from '../ui/CapabilityPills.astro';
import ChapterHeader from '../ui/ChapterHeader.astro';
import VideoCTA from '../ui/VideoCTA.astro';
import { smartCityUrl } from '../../data/smart-city-media';
---
<section id="citysafe" class="chapter" aria-labelledby="citysafe-heading">
      <div class="citysafe-hero dark">
        <div class="citysafe-backdrop">
          <PhotographicHero file="call-box-city.webp" alt="A red New York City emergency call box with fire and police buttons on a street at dusk" />
        </div>
        <div class="citysafe-content">
          <div class="citysafe-editorial">
            <ChapterHeader number="01" date="2005" descriptor="THE BEGINNING: CITYSAFE" layout="editorial" />
            <h2 id="citysafe-heading" class="citysafe-question"><span>I started with a</span> <span>simple question:</span> <span>How could a city</span> <span>communicate better?</span></h2>
            <div class="citysafe-support">
              <p>My interest in outdoor advertising led me to think differently about how we connect the streets in times of emergencies.</p>
              <p>After 9/11 I began exploring real-time, interactive, street-level emergency messaging with direct access to a live emergency operator.</p>
            </div>
          </div>
        </div>
      </div>
      <div class="citysafe-panels">
        <div class="citysafe-invention-copy">
          <p class="eyebrow">FROM IDEA TO INVENTION</p>
          <h3>What if the call box could become something more?</h3>
          <p>CitySafe began as an idea to reinvent outdated public infrastructure, transforming the call box into a connected communication hub for safety, information and community.</p>
          <CapabilityPills class="citysafe-capabilities" label="CitySafe capabilities" items={['TWO-WAY COMMUNICATION', 'EMERGENCY SERVICES', 'CAMERAS', 'SENSORS', 'LOCAL INFORMATION', 'COMMUNITY']} />
        </div>
        <div class="citysafe-story-panel">
          <div class="citysafe-image-frame"><SupportingPhoto file="citysafe-nyc-hero.webp" alt="CitySafe emergency touchscreen integrated into a New York City phone booth near Penn Station" class="citysafe-concept-photo" /></div>
          <div class="citysafe-action citysafe-video-action">
            <VideoCTA label="WATCH CITYSAFE STORY" title="CitySafe film coming soon" fullWidth />
          </div>
        </div>
        <div class="citysafe-patent-panel">
          <a class="citysafe-patent-link" href={smartCityUrl("US20080304628.pdf")} aria-disabled={!smartCityUrl("US20080304628.pdf") ? "true" : undefined} target="_blank" rel="noopener noreferrer" aria-label="View CitySafe patent US20080304628 (PDF)">
          <div class="citysafe-image-frame"><img src={smartCityUrl("patent_payphone_image.webp") ?? "/images/media-placeholder.svg"} alt="Original patent drawing, Figure 5, showing a payphone with an emergency assistance screen" loading="lazy" decoding="async"/></div>
          <span class="citysafe-action">{smartCityUrl("US20080304628.pdf") ? "VIEW PATENT" : "PATENT PDF COMING SOON"} <span aria-hidden="true">→</span></span>
        </a>
          <p class="citysafe-patent-caption">EARLY CONCEPT AND PATENT DRAWING</p>
        </div>
      </div>
    </section>
