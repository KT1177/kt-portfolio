---
import { smartCityUrl } from '../../data/smart-city-media';
---
<section id="partnerships" class="partnerships dark">
      <div class="section-heading">
        <p class="chapter-meta"><span>06</span><strong><small>Partnerships + client work</small></strong></p>
        <h2>Beyond our own platforms.</h2>
        <p>The same thinking. New places and partners.</p>
      </div>
      <div class="partnership-grid">
        <figure class="partner-photo">
          <img src={smartCityUrl("chicago-jcd-citypost-1.webp") ?? "/images/media-placeholder.svg"} alt="JCDecaux CityPost information kiosk on a Chicago street" loading="lazy" decoding="async"/>
          <figcaption><strong>JCDecaux</strong><span>CHICAGO PILOT</span></figcaption>
        </figure>
        <figure class="partner-photo">
          <img src={smartCityUrl("reno-screen-kt-port.webp") ?? "/images/media-placeholder.svg"} alt="Lamar interactive airport screen in Reno installation" loading="lazy" decoding="async"/>
          <figcaption><strong>Lamar</strong><span>AIRPORT EXPERIENCE</span></figcaption>
        </figure>
      </div>
    </section>
