---
import { smartCityUrl } from '../../data/smart-city-media';
---
<section id="citypost" class="chapter dark">
      <div class="citypost-photographic-area">
        <div class="citypost-scene" aria-hidden="true">
          <img src={smartCityUrl("citypost-screens-final.webp") ?? "/images/media-placeholder.svg"} alt="" loading="lazy" decoding="async"/>
        </div>
        <div class="citypost-grid">
          <div class="chapter-copy">
            <p class="chapter-meta"><span>04</span><strong><small>The platform behind the screens</small></strong></p>
            <h2>CityPost</h2>
            <h3>The screens were only the beginning.</h3>
            <p>I designed CityPost from the ground up as a visual-first platform for managing screens, devices, content, advertising, data and users across an entire digital network.</p>
          </div>
        </div>
      </div>
    </section>
