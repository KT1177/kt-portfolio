---
import DocumentViewer from '../ui/DocumentViewer.astro';
import ChapterHeader from '../ui/ChapterHeader.astro';
const recommendations = [
  { logo: 'dart-logo.svg', pdf: 'DART-KT-Reco.pdf', documentTitle: 'DART Recommendation', organization: 'DART', quote: '“Karl played a pivotal role in the creation of DART’s CityPost real-time transit alerts platform. His work ensured seamless API integration of daily and emergency notifications across our 600-screen network, both system-wide and regionally.”', name: 'Taty Benavidez', title: 'Manager, Customer Information and Production', attribution: 'Dallas Area Rapid Transit' },
  { logo: 'greensboro-logo.svg', pdf: 'GB-KT-Reco.pdf', documentTitle: 'City of Greensboro Recommendation', organization: 'City of Greensboro', quote: '“Karl consistently demonstrates outstanding responsiveness to our team’s content and application requests, tailoring the platform to meet Greensboro’s unique needs.”', name: 'Rodney Roberts, CGCIO', title: 'Chief Information Officer', attribution: 'City of Greensboro' },
  {"organization": "CITY OF AURORA", "quote": "“We chose Smart City Media based on their experience and service ethic.”", "name": "Michael Pegues", "title": "Chief Information Officer", "attribution": "City of Aurora, Illinois", "pdf": "Aurora Reference SCM.pdf", "documentTitle": "City of Aurora Recommendation", "logo": "cityofaurora_logo_seal_coated_color.svg", "logoAlt": "City of Aurora"},
  {"organization": "CITY OF JERSEY CITY", "quote": "“Smart City Media has been a fantastic partner for us.”", "name": "Brian D. Platt", "title": "Business Administrator", "attribution": "City of Jersey City, New Jersey", "pdf": "JC Smart City Media Letter of Support final.pdf", "documentTitle": "Jersey City Recommendation", "logo": "JC_logo.svg", "logoAlt": "City of Jersey City"},
  {"organization": "KC STREETCAR", "quote": "“Smart City Media has been a primary partner in our overall Smart City initiative and they have added real public-facing value to our transit deployments.”", "name": "Tom Gerend", "title": "Executive Director", "attribution": "Kansas City Streetcar Authority", "pdf": "KC Streetcar Reference SCM.pdf", "documentTitle": "KC Streetcar Recommendation", "logo": "KCStreetcar%20Brandmark.svg", "logoAlt": "KC Streetcar"},
  {"organization": "CITY OF LITTLE ROCK", "quote": "“Citizens and visitors alike are excited to have updated information on community activities available for review.”", "name": "Mark Stodola", "title": "Mayor", "attribution": "City of Little Rock, Arkansas", "pdf": "Little Rock Reference SCM.pdf", "documentTitle": "City of Little Rock Recommendation", "logo": "LittleRock_Logo.svg", "logoAlt": "City of Little Rock"},
  {"organization": "KANSAS CITY", "quote": "“SCM is actually trying to connect your communities.”", "name": "Sylvester “Sly” James", "title": "Former Mayor", "attribution": "Kansas City, Missouri", "pdf": "Sly James Reference SCM.pdf", "documentTitle": "Sly James Recommendation", "logo": "kc_logo.svg", "logoAlt": "Kansas City"},
];
const base = 'https://pub-e185fd1db9bf4dd59d2b99be455217bd.r2.dev/smart-city/';
const awards = [
  {file:'ada-sapolin.png', name:'New York City ADA Sapolin Award', lines:['New York City','ADA Sapolin Award'], size:'certificate'},
  {file:'smart-50.webp', name:'Smart 50 Award', lines:['Smart 50 Award'], size:'medium'},
  {file:'idc-gold.webp', name:'IDC Gold Award — Community Engagement', lines:['IDC Gold Award','Community Engagement'], size:'small'},
  {file:'edison-gold.webp', name:'Edison Gold Innovation Award', lines:['Edison Gold','Innovation Award'], size:'tall'},
  {file:'cleantech.webp', name:'Diversity, Equity and Inclusion in Cleantech', lines:['Diversity, Equity and','Inclusion in Cleantech'], size:'cleantech'},
];
---
<section id="recognition" class="recognition" aria-labelledby="recognition-heading">
  <div class="recognition-recommendations">
    <div class="recognition-heading">
      <ChapterHeader number="07" descriptor="RECOGNITION" layout="hanging" />
      <h2 id="recognition-heading">Built with cities.<br />Recognized by industry.</h2>
    </div>
    <recommendation-carousel>
      <div class="recommendation-track" tabindex="0" aria-label="Recommendations, horizontally scrollable">
        {recommendations.map((recommendation) => <article class="recommendation-card" aria-label={recommendation.organization}>
          <div class="recommendation-logo-placeholder">{recommendation.logo ? <img class="recommendation-logo" src={base + recommendation.logo} alt={'logoAlt' in recommendation ? recommendation.logoAlt : `${recommendation.organization} logo`} loading="lazy" decoding="async" /> : recommendation.organization && <span class="recommendation-identity">{recommendation.organization}</span>}</div>
          <p class="recommendation-excerpt">{recommendation.quote || <><span>Recommendation to come</span><br />Approved quotation will appear here.</>}</p>
          <div class="recommendation-attribution"><p><strong>{recommendation.name || 'Name pending'}</strong></p>{recommendation.title && <p>{recommendation.title}</p>}{recommendation.attribution && <p>{recommendation.attribution}</p>}</div>
          {recommendation.pdf ? <button type="button" class="recommendation-letter" data-document-url={base + 'smart-city-pdfs/' + encodeURIComponent(recommendation.pdf)} data-document-title={recommendation.documentTitle} aria-haspopup="dialog">VIEW LETTER →</button> : <span class="recommendation-letter" aria-disabled="true">LETTER TO COME</span>}
        </article>)}
      </div>
      <div class="recommendation-controls">
        <span aria-live="polite" class="recommendation-position">01 / {String(recommendations.length).padStart(2, '0')}</span>
        <button type="button" data-step="-1" aria-label="Previous recommendation" disabled>←</button>
        <button type="button" data-step="1" aria-label="Next recommendation">→</button>
      </div>
    </recommendation-carousel>
  </div>
  <div class="recognition-awards">
    <h3>Smart City Awards</h3>
    <div class="recognition-award-grid">
      {awards.map(award => <figure class={`recognition-award recognition-award--${award.size}`}>
        <div class="recognition-award-stage"><img src={base+award.file} alt={award.name} loading="lazy" decoding="async" /></div>
        <figcaption>{award.lines.map(line => <span>{line}</span>)}</figcaption>
      </figure>)}
    </div>
  </div>
</section>
<DocumentViewer />
<script>
  class RecommendationCarousel extends HTMLElement {
    private observer?: ResizeObserver;
    connectedCallback() {
      const track = this.querySelector<HTMLElement>('.recommendation-track')!;
      const cards = Array.from(track.querySelectorAll<HTMLElement>('.recommendation-card'));
      const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('button[data-step]'));
      const position = this.querySelector('.recommendation-position')!;
      const step = () => cards[1].offsetLeft - cards[0].offsetLeft;
      const update = () => {
        const atEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
        const index = atEnd ? cards.length - 1 : Math.min(cards.length - 1, Math.round(track.scrollLeft / step()));
        position.textContent = `${String(index + 1).padStart(2,'0')} / ${String(cards.length).padStart(2,'0')}`;
        buttons[0].disabled = track.scrollLeft <= 1;
        buttons[1].disabled = track.scrollLeft >= track.scrollWidth-track.clientWidth-1;
      };
      buttons.forEach(button => button.onclick = () => track.scrollBy({left:Number(button.dataset.step)*step(),behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'}));
      track.onscroll = update;
      this.observer = new ResizeObserver(update);
      this.observer.observe(track);
      update();
    }
    disconnectedCallback() { this.observer?.disconnect(); }
  }
  if (!customElements.get('recommendation-carousel')) customElements.define('recommendation-carousel', RecommendationCarousel);
</script>
