---
import ChapterHeader from '../ui/ChapterHeader.astro';
const recommendations = [
  { logo: 'dart-logo.svg', pdf: 'DART-KT-Reco.pdf', organization: 'DART', quote: '“Karl played a pivotal role in the creation of DART’s CityPost real-time transit alerts platform. His work ensured seamless API integration of daily and emergency notifications across our 600-screen network, both system-wide and regionally.”', name: 'Taty Benavidez', title: 'Manager, Customer Information and Production', attribution: 'Dallas Area Rapid Transit' },
  { logo: 'greensboro-logo.svg', pdf: 'GB-KT-Reco.pdf', organization: 'City of Greensboro', quote: '“Karl consistently demonstrates outstanding responsiveness to our team’s content and application requests, tailoring the platform to meet Greensboro’s unique needs.”', name: 'Rodney Roberts, CGCIO', title: 'Chief Information Officer', attribution: 'City of Greensboro' },
  ...Array.from({length:6}, (_,i) => ({logo: '', pdf: '', organization: `Recommendation ${i+3}`, quote: '', name: '', title: '', attribution: ''})),
];
const base = 'https://pub-e185fd1db9bf4dd59d2b99be455217bd.r2.dev/smart-city/';
const awards = [
  {file:'ada-sapolin.png', name:'New York City ADA Sapolin Award', lines:['New York City','ADA Sapolin Award'], size:'certificate'},
  {file:'smart-50.webp', name:'Smart 50 Award', lines:['Smart 50 Award'], size:'medium'},
  {file:'idc-gold.webp', name:'IDC Gold Award — Community Engagement', lines:['IDC Gold Award','Community Engagement'], size:'small'},
  {file:'edison-gold.webp', name:'Edison Gold Innovation Award', lines:['Edison Gold','Innovation Award'], size:'tall'},
  {file:'cleantech.webp', name:'Diversity, Equity and Inclusion in Cleantech', lines:['Diversity, Equity and','Inclusion in Cleantech'], size:'cleantech'},
];
---
<section id="recognition" class="recognition" aria-labelledby="recognition-heading">
  <div class="recognition-recommendations">
    <div class="recognition-heading">
      <ChapterHeader number="07" descriptor="RECOGNITION" layout="hanging" />
      <h2 id="recognition-heading">Built with cities.<br />Recognized by industry.</h2>
    </div>
    <recommendation-carousel>
      <div class="recommendation-track" tabindex="0" aria-label="Recommendations, horizontally scrollable">
        {recommendations.map((recommendation, index) => <article class="recommendation-card" aria-label={`${recommendation.organization}${index > 1 ? ", content pending" : ""}`}>
          <div class="recommendation-logo-placeholder">{recommendation.logo ? <img class="recommendation-logo" src={base + recommendation.logo} alt={`${recommendation.organization} logo`} loading="lazy" decoding="async" /> : 'Organization pending'}</div>
          <p class="recommendation-excerpt">{recommendation.quote || 'Approved recommendation pending.'}</p>
          <div class="recommendation-attribution"><p><strong>{recommendation.name || 'Name pending'}</strong></p><p>{recommendation.title || 'Title pending'}</p><p>{recommendation.attribution || 'Organization pending'}</p></div>
          {recommendation.pdf ? <a class="recommendation-letter" href={base + 'smart-city-pdfs/' + recommendation.pdf} target="_blank" rel="noopener noreferrer" aria-label={`View ${recommendation.organization} recommendation letter (PDF, opens in new tab)`}>VIEW LETTER →</a> : <span class="recommendation-letter" aria-disabled="true">VIEW LETTER → <small>PDF pending</small></span>}
        </article>)}
      </div>
      <div class="recommendation-controls">
        <span aria-live="polite" class="recommendation-position">01 / 08</span>
        <button type="button" data-step="-1" aria-label="Previous recommendation" disabled>←</button>
        <button type="button" data-step="1" aria-label="Next recommendation">→</button>
      </div>
    </recommendation-carousel>
  </div>
  <div class="recognition-awards">
    <h3>Smart City Awards</h3>
    <div class="recognition-award-grid">
      {awards.map(award => <figure class={`recognition-award recognition-award--${award.size}`}>
        <div class="recognition-award-stage"><img src={base+award.file} alt={award.name} loading="lazy" decoding="async" /></div>
        <figcaption>{award.lines.map(line => <span>{line}</span>)}</figcaption>
      </figure>)}
    </div>
  </div>
</section>
<script>
  class RecommendationCarousel extends HTMLElement {
    private observer?: ResizeObserver;
    connectedCallback() {
      const track = this.querySelector<HTMLElement>('.recommendation-track')!;
      const cards = Array.from(track.querySelectorAll<HTMLElement>('.recommendation-card'));
      const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('button'));
      const position = this.querySelector('.recommendation-position')!;
      const step = () => cards[1].offsetLeft - cards[0].offsetLeft;
      const update = () => {
        const index = Math.min(cards.length - 1, Math.round(track.scrollLeft / step()));
        position.textContent = `${String(index + 1).padStart(2,'0')} / 08`;
        buttons[0].disabled = track.scrollLeft <= 1;
        buttons[1].disabled = track.scrollLeft >= track.scrollWidth-track.clientWidth-1;
      };
      buttons.forEach(button => button.onclick = () => track.scrollBy({left:Number(button.dataset.step)*step(),behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'}));
      track.onscroll = update;
      this.observer = new ResizeObserver(update);
      this.observer.observe(track);
      update();
    }
    disconnectedCallback() { this.observer?.disconnect(); }
  }
  if (!customElements.get('recommendation-carousel')) customElements.define('recommendation-carousel', RecommendationCarousel);
</script>
