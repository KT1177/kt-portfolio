---
import { smartCityUrl } from '../../data/smart-city-media';
// Add confirmed deployments here in their supplied order.
const deployments = [{ name: 'Jersey City', image: smartCityUrl('JC-kiosk-city.webp') }];
---
<deployment-carousel class="scm-deployments">
  <div class="scm-deployment-track" tabindex="0" aria-label="City deployments, horizontally scrollable">
    {deployments.map(item => <figure class="scm-deployment-card">
      {item.image ? <img src={item.image} alt={`Smart City Media deployment in ${item.name}`} loading="lazy" /> : <div class="scm-deployment-placeholder" aria-label={`${item.name} photograph pending`} />}
      <figcaption><span>{item.name}</span><span aria-hidden="true">↗</span></figcaption>
    </figure>)}
  </div>
  <div class="scm-carousel-footer">
    <p>Across cities and public spaces</p>
    <div class="scm-carousel-controls">
      <span class="scm-carousel-position" aria-live="polite">01 / {String(deployments.length).padStart(2, '0')}</span>
      <button type="button" data-direction="-1" aria-label="Previous deployment" disabled>←</button>
      <button type="button" data-direction="1" aria-label="Next deployment" disabled={deployments.length < 2}>→</button>
    </div>
  </div>
</deployment-carousel>
<script>
  class DeploymentCarousel extends HTMLElement {
    connectedCallback() {
      const track = this.querySelector<HTMLElement>('.scm-deployment-track')!;
      const cards = Array.from(track.querySelectorAll<HTMLElement>('.scm-deployment-card'));
      const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('button'));
      const position = this.querySelector('.scm-carousel-position')!;
      const update = () => {
        const step = cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : 1;
        const index = Math.min(cards.length - 1, Math.round(track.scrollLeft / step));
        position.textContent = `${String(index + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
        buttons[0].disabled = track.scrollLeft <= 1;
        buttons[1].disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 1;
      };
      buttons.forEach(button => button.addEventListener('click', () => {
        const step = cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : track.clientWidth;
        track.scrollBy({ left: Number(button.dataset.direction) * step, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      }));
      track.addEventListener('scroll', update, { passive: true });
      const observer = new ResizeObserver(update);
      observer.observe(track);
      this.addEventListener('astro:unmount', () => observer.disconnect(), { once: true });
      update();
    }
  }
  if (!customElements.get('deployment-carousel')) customElements.define('deployment-carousel', DeploymentCarousel);
</script>
