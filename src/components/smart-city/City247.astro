---
import { smartCityUrl } from '../../data/smart-city-media';
---
<section id="city247" class="chapter dark city247">
      <div class="city247-editorial">
        <div class="city247-introduction">
          <div class="chapter-copy">
            <p class="chapter-meta"><span>02</span><strong><span class="meta-year">2012</span><small>New York City</small></strong></p>
            <h2>City24/7</h2>
            <h3>From concept to the streets of Manhattan.</h3>
            <p>CitySafe evolved into City24/7, bringing real time information, public services, local content and connectivity directly to city streets.</p>
          </div>
          <figure class="city247-pullquote">
            <blockquote><span class="hanging-quote">“</span>The best product I’ve seen in years.”</blockquote>
            <figcaption><span>Michael Bloomberg</span><span>Mayor of New York City</span></figcaption>
          </figure>
        </div>
        <figure class="city247-photograph">
          <div class="city247-photo-frame">
            <img src={smartCityUrl("247-jennifer-faulk.webp") ?? "/images/media-placeholder.svg"} alt="Jennifer Faulk interacting with the City24/7 touchscreen in Union Square" loading="lazy" decoding="async"/>
            <div class="stat city247-photo-proof"><strong>11</strong><span>Interactive kiosks<small>New York City pilot</small></span></div>
          </div>
          <figcaption class="city247-photo-caption"><strong>Jennifer Faulk</strong><span>President, Union Square Partnership</span><span>Union Square, New York City</span></figcaption>
        </figure>
      </div>
    </section>
