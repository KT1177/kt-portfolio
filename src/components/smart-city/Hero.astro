---
import { smartCityUrl } from '../../data/smart-city-media';
---
<section class="hero dark">
      <div class="hero-backdrop">
        <figure class="media-slot" style="aspect-ratio:16/9">
          <img src={smartCityUrl("smart-city-hero-nyc.webp") ?? "/images/media-placeholder.svg"} alt="New York City at sunset, with the Empire State Building rising above the skyline and golden light to the right" loading="eager" fetchpriority="high" decoding="async"/>
        </figure>
      </div>
      <div class="hero-content">
        <p class="eyebrow">Smart City<br/>2005 – Present</p>
        <h1><span class="hero-headline-line">From</span> <span class="hero-headline-line">Madison Avenue</span> <span class="hero-headline-line">to the streets of</span> <span class="hero-headline-line">the connected city.</span></h1>
        <p class="hero-intro">A 20 year journey building products, platforms and technologies that changed how people connect with the places around them.</p>
        <div class="film-pending">
          <button type="button" disabled class="video-inline-trigger">
            <span aria-hidden="true">▷</span> Intro film — coming soon
          </button>
        </div>
        <a class="journey-link" href="#citysafe">Explore the journey <span>↓</span></a>
      </div>
    </section>
