---
import { getImage } from 'astro:assets';
import type { ProjectImage } from './types';
interface Props { image: ProjectImage; sizes?: string; }
const { image, sizes = '(min-width: 768px) 768px, 100vw' } = Astro.props;
const { src, alt, width, height, delivery } = image;
if (!(width > 0 && height > 0)) throw new Error('Project images require native dimensions.');
const widths = delivery ? [...new Set(delivery.widths.filter(w => w > 0 && w <= width).concat(width))].sort((a,b) => a-b) : [];
async function variants(format: 'avif' | 'webp', quality: number) {
  return Promise.all(widths.map(async w => {
    const result = await getImage({ src, width: w, height: Math.round(w * height / width), format, quality });
    return `${result.src} ${w}w`;
  })).then(items => items.join(', '));
}
const webp = delivery ? await variants('webp', delivery.webpQuality) : undefined;
const avif = delivery?.avifQuality !== undefined ? await variants('avif', delivery.avifQuality) : undefined;
---
<picture>
  {avif && <source type="image/avif" srcset={avif} sizes={sizes} />}
  {webp && <source type="image/webp" srcset={webp} sizes={sizes} />}
  <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
</picture>
<style>
  picture { display:block; }
  img { display:block;width:100%;height:auto; }
</style>
